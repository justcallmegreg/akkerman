# Backend Environment Configuration
# Copy this file to .env and customize for your environment

# Flask environment (development, testing, production)
FLASK_ENV=development

# Database configuration
# SQLite (default - file-based):
# SQLALCHEMY_DATABASE_URI=sqlite:///./akkerman.db

# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/akkerman

# MySQL example:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/akkerman

# Connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# SQLAlchemy debug (shows SQL queries)
SQLALCHEMY_ECHO=False

# Flask app settings
FLASK_APP=app.py
FLASK_DEBUG=False
